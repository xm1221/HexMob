{
  // Hex Mob 中文本地化（zh_cn）
  hexmob: {
    book: {
      patterns: {
        spells: {
          "quench_allay": {
            "": "淬晶悦灵相关图案",
            "0": "接受一只悦灵，消耗一枚淬灵晶碎片，将其转化为淬晶悦灵（随身物品一并保留）。",
            "1": "接受淬晶悦灵与一个向量，使其飞向该点。",
            "2": "接受淬晶悦灵与一串 iota，使其施放该法术，消耗其自身物品栏中的媒质"
          },
        "transform_stimulated_pattern": {
          "": "转化活化图案",
          "0": "接受一块$(l:hexcasting:items/stimulated_slate)活化石板$(/l)的位置、一只$(l:hexcasting:hexmob/stimulated_pattern)活化图案实体$(/l)与一个图案。尝试将活化图案实体转化为活化石板。消耗 10 紫水晶粉。",
          "1": "如果给出的图案与活化图案实体所持图案笔迹相同，该实体便会就此散尽，活化石板则被写入这一图案；否则实体将失去 5 点生命值，再无他事发生。"
        }
        }
      },
      items: {
        "stimulated_slate": {
          "0": "活化石板看似普通石板，实则大不相同。$(br)其一，除通过$(l:hexcasting:patterns/spells/transform_stimulated_pattern)此图案$(/l)写入外，其上图案不可更改。其二，若如普通石板一般参与法术环，且其上写有图案，则活化石板会径直放行媒质波而不作执行，却为随后的施放提供 10% 的媒质折扣。",
          "1": "若一座法术环中出现两块笔迹相同的活化石板，便会触发一场事故；亦有些图案无法享受此折扣——这或许便是自然的保留地。"
        }
      },
      hexmob: {
        "name": "奇妙的生物",
        "description": "此分类收录了我在世界各地收集到的奇妙生物记录。",
        "stimulated_pattern": {
          "": "活化图案",
          "0": "活化图案是一种神秘的生灵，看起来就像悬浮在半空中的一个咒法图案。这些友善的生灵可以在某些紫水晶晶洞中见到。$(br)一位名叫 Whiteord 的咒术师对它们进行过几番研究，其发现可用于制作$(l:hexcasting:items/stimulated_slate)活化石板$(/l)与$(l:hexcasting:patterns/spells/transform_stimulated_pattern)转化活化图案$(/l)。",
          "1": "紫水晶晶洞中的一只活化图案。"
        },
        "crying_amethyst": {
          "": "尖叫紫水晶",
          "0": "这些神秘的生物（我也不敢确定它们究竟算不算\u201c生物\u201d），最初由咒术师 cang_hai_yi_su 记录，偶尔现身于紫水晶晶洞。它看起来就像一株上面长着紫水晶芽的萌芽紫水晶，没有威胁；但被杀死时会掉落一些紫水晶。$(br)若是受到攻击，尖叫紫水晶可能会像恶魂一般嚎叫。那声音真叫人毛骨悚然，我不禁好奇它们究竟经历过什么……",
          "1": "晶洞中的一只尖叫紫水晶。"
        },
        "iota_sheep": {
          "": "咒念羊",
          "0": "这些古怪的羊时常出没于原野的边缘，每一只都把某个 Iota 系进了羊毛里。羊毛的颜色会随其承载的 Iota 类型而流转，而剪下羊毛，便能得到几枚$(l:hexcasting:items/thought_knot)结念绳$(/l)，每一枚都复写了一份那个iota。咒念羊可以用$(action)编年史家之纯化$()和$(action)编年史家之策略$()读写。",
          "1": "那 iota 可不只是装饰——羊会照它所承载的意志行事。向量Iota会让它慢慢的朝那一点踱去；一枚实体Iota则让它不由自主地靠近那生灵；向量列表会叫它化身为小小巡哨，在列表规定的几个向量处反复巡游；若是别的列表，则只是让羊毛的颜色周而复始地轮转。$(br2)如今已有咒术师习惯于往羊身上托付 Iota，只为看它们如何一边“咩咩”叫着，一边不由自主地做着蠢事。",
          "2": "一只随时可以修剪的咒念羊。"
        },
        "quench_allay": {
          "": "淬晶悦灵",
          "0": "历经卓越的启迪，我已对媒质与意识有了超乎寻常的掌控。受咒念羊的启发，我着手创造另一种能够储存 Iota 的生物。经数次试验，令淬灵晶与悦灵互为相融，终获成功，而结果远超预期——我所创造的淬晶悦灵，不仅能像咒念羊那般储存 Iota，亦能被法术轻易拨弄，甚至能以它自身的名义施法。",
          "1": "相关图案见$(l:hexcasting:patterns/spells/quench_allay)淬晶悦灵相关图案$(/l)。",
          "2": "以淬灵晶碎片淬炼而成的淬晶悦灵。"
        }
      }
    }
  },
